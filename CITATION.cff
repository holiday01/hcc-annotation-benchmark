    given-names: Yen-Jung
    affiliation: Chang Gung University
license: MIT
repository-code: "https://github.com/holiday01/hcc-annotation-benchmark"
keywords:
  - single-cell RNA sequencing
  - cell-type annotation
  - benchmarking
  - hepatocellular carcinoma
  - HCC
  - reproducibility
